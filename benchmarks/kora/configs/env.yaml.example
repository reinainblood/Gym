#
# KORA run wiring. Copy to ./env.yaml at the repository root (Gym auto-loads it from the
# cwd) and fill in the endpoints. Never commit the filled-in copy; env.yaml is gitignored.
#
# Keys come from the shell via ${oc.env:VAR}; URLs and model ids go here. Three roles:
#
#   policy_model      the model under test
#   kora_judge_model  GPT-5.2 at medium reasoning effort, the published judge
#   kora_child_model  DeepSeek V3.2 at temperature 1.3, the published child simulator
#
# The judge and the child must never be the policy: pointing either at the model under
# test would have it grade, or drive, its own conversations.

# --- Model under test -----------------------------------------------------------------
# Any OpenAI-compatible chat endpoint. Upstream ran each target with that provider's
# defaults for the slug (its "-high" targets are the reasoning-effort-high variants), so
# record the decoding you use next to the scores.
policy_model:
  responses_api_models:
    inference_provider:
      entrypoint: app.py
      base_url: <your-openai-compatible-base-url>/v1
      api_key: ${oc.env:POLICY_API_KEY,""}
      model: <your-model-id>
      # Reasoning models on vLLM/SGLang return reasoning in a separate field; without
      # this the converter would fold it into the visible answer and the child and the
      # judge would read the model's scratchpad as if it had been said to a child.
      uses_reasoning_parser: true
      num_concurrent_requests: 32

# --- Judge -----------------------------------------------------------------------------
# profiles/kora.json upstream: openai/gpt-5.2, reasoningEffort medium, maxTokens 26000,
# structured output. openai_model speaks the Responses API, which carries both the
# reasoning effort and the JSON schema (`text.format`) natively.
kora_judge_model:
  responses_api_models:
    openai_model:
      entrypoint: app.py
      openai_base_url: https://api.openai.com/v1
      openai_api_key: ${oc.env:OPENAI_API_KEY,""}
      openai_model: gpt-5.2
      max_concurrent_requests: 32
      extra_body:
        reasoning:
          effort: medium

# --- Child simulator -------------------------------------------------------------------
# profiles/kora.json upstream: deepseek/deepseek-v3.2, temperature 1.3; every child call
# is capped at 300 output tokens by the harness (generateUserMessage.ts). Served through
# the chat-completions adapter since DeepSeek and OpenRouter have no Responses endpoint.
kora_child_model:
  responses_api_models:
    inference_provider:
      entrypoint: app.py
      base_url: https://openrouter.ai/api/v1
      api_key: ${oc.env:OPENROUTER_API_KEY,""}
      model: deepseek/deepseek-v3.2
      uses_reasoning_parser: false
      num_concurrent_requests: 32

# DeepSeek's own API works the same way; swap the block above for:
#
# kora_child_model:
#   responses_api_models:
#     inference_provider:
#       entrypoint: app.py
#       base_url: https://api.deepseek.com/v1
#       api_key: ${oc.env:DEEPSEEK_API_KEY,""}
#       model: <DeepSeek's id for V3.2 in non-thinking mode>
#       uses_reasoning_parser: false
#       num_concurrent_requests: 32
